# 玩家名（不设则默认 rw-chat-headless）
NAME=
# 固定客户端 UUID：不设则首次运行自动生成随机 UUID 并持久化到 data/client-uuid
# （每个部署一份、跨重启稳定；换身份删该文件即可。容器/CI 建议显式设置）
CLIENT_UUID=
# 房间密码（有密码的房）
PASSWORD=
# 语言（en/zh）
LANGUAGE=zh
# 注册格式：5=完整指纹（默认，v176 系要求）；2=老格式精简
REGISTER_FORMAT=5
# 核心单位校验和：留空用内置 678359601（v176，从真实客户端抓取）。
# 可用 tools/capture-server.ts 抓取自定义校验和；其他版本也可能需要调整包结构。
UNITS_CHECKSUM=
# 明确的 117 房间号提示应答；通常自动使用输入代码或当前地址查询串
RELAY_ROOM_ID=
# 调试：打印所有收到的帧
DEBUG=0
# 可选 SOCKS5 出口（全部连接走它）
RW_SOCKS_PROXY=
# 入房总等待预算（毫秒，含中继跳转）；0 禁用。服务器输入等待单独计时。
JOIN_TIMEOUT_MS=45000
# 入房后多久未收到完整协议帧判为失联；0 禁用，不按聊天或 109 回包判断。
RECEIVE_TIMEOUT_MS=60000
# 独立 CLI / 多房模式可选自动重连；已有外部 Worker 管理重试时保持 0。
AUTO_RECONNECT=0
# 一次启动最多重试 10 次，成功入房不重置预算。退出、被踢等终态停止。
RECONNECT_MAX_RETRIES=10
# 指数退避 5/10/20/40/60 秒，带抖动，等待不超过 RECONNECT_MAX_MS。
RECONNECT_BASE_MS=5000
RECONNECT_MAX_MS=60000

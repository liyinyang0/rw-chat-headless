{
  "name": "rw-chat-headless",
  "version": "0.1.0",
  "description": "Headless chat-only Rusted Warfare battleroom client — joins any server (list/room-code/IP) and chats. Pure protocol implementation, no game engine, no gameplay.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit",
    "start": "tsx src/cli.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.include=src/masterserver/** --coverage.include=src/protocol/hashes.ts --coverage.include=src/protocol/integrity.ts --coverage.include=src/protocol/packets/common.ts --coverage.include=src/protocol/packets/pow.ts --coverage.include=src/protocol/packets/room.ts --coverage.include=src/client/session.ts --coverage.include=src/client/connection.ts --coverage.include=src/client/reconnecting.ts --coverage.include=src/client/multi.ts"
  },
  "dependencies": {
    "tsx": "^4.19.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "2.1.9",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "license": "AGPL-3.0-only"
}

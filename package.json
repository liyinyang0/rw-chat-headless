{
  "name": "rw-chat-headless",
  "version": "0.1.0",
  "description": "Headless chat-only Rusted Warfare battleroom client — joins any server (list/room-code/IP) and chats. Pure protocol implementation, no game engine, no gameplay.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit",
    "start": "tsx src/cli.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "tsx": "^4.19.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.18.1",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "license": "AGPL-3.0-only"
}
